# Dashboard auth. Required when the dashboard binds beyond localhost.
# Copy to .env and fill in. .env stays untracked.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Bearer token for https://hermesapi.surajram.online. Minimum 8 characters.
# openssl rand -hex 32
API_SERVER_KEY=
